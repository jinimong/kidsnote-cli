{
  "name": "kidsnote-cli",
  "version": "0.1.0",
  "description": "키즈노트 알림장/공지사항 JSON 조회 CLI",
  "author": "jinimong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinimong/kidsnote-cli"
  },
  "homepage": "https://github.com/jinimong/kidsnote-cli#readme",
  "bugs": {
    "url": "https://github.com/jinimong/kidsnote-cli/issues"
  },
  "keywords": [
    "kidsnote",
    "키즈노트",
    "cli",
    "daycare",
    "json"
  ],
  "main": "dist/cli.js",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "kidsnote": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "postinstall": "npx --yes playwright install chromium",
    "prepare": "npm run build || echo '⚠️  Build skipped — run npm run build manually to diagnose'",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^20.10.0",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write --no-errors-on-unmatched"
  }
}
